# Base de datos PostgreSQL
# Opciones gratuitas: Neon (recomendado), Supabase, o Docker local
DATABASE_URL=postgresql://user:password@host:5432/promedio_notas

# Clave secreta para firmar tokens JWT (cambiar en produccion)
JWT_SECRET=your-secret-key-here-change-in-production

# Puerto del servidor backend (opcional, default: 3001)
PORT=3001

# URL del API para el frontend (opcional en desarrollo con proxy de Vite)
VITE_API_URL=http://localhost:3001/api

# Email (Brevo) - necesario para recuperacion de contraseña
BREVO_API_KEY=xkeysib-xxxxx

# Google OAuth
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

# Frontend URL (para enlaces de reset de contraseña)
FRONTEND_URL=http://localhost:5173
