{
  "buildCommand": "npm run build -w packages/shared && npx prisma generate --schema=packages/backend/prisma/schema.prisma && npm run build -w packages/backend && npm run build -w packages/frontend",
  "outputDirectory": "packages/frontend/dist",
  "framework": "vite",
  "functions": {
    "api/index.ts": {
      "includeFiles": "packages/backend/dist/**,node_modules/.prisma/client/**,node_modules/@prisma/client/**,packages/backend/prisma/schema.prisma"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
