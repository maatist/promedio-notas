{
  "buildCommand": "npm run build -w packages/shared && npm run build -w packages/backend && npm run build -w packages/frontend",
  "outputDirectory": "packages/frontend/dist",
  "framework": "vite",
  "functions": {
    "api/index.ts": {
      "includeFiles": "packages/backend/dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
